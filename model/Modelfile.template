FROM "__GGUF_PATH__"
# Weights: tencent/Hy-MT2-1.8B-GGUF, Q4_K_M, see assets.json.
# Official prompt format: https://huggingface.co/tencent/Hy-MT2-1.8B/blob/main/chat_template.jinja
# LLM Text Assistant places translation instructions/source in system, then sends a fixed user trigger.
TEMPLATE """<｜hy_begin▁of▁sentence｜>{{ range .Messages }}{{ if eq .Role "system" }}<｜hy_User｜>{{ .Content }}{{ else if eq .Role "user" }}{{ if and (ne .Content "Process the text.") (ne .Content "Verarbeite den Text.") }}<｜hy_User｜>{{ .Content }}{{ end }}{{ else if eq .Role "assistant" }}<｜hy_Assistant｜>{{ .Content }}<｜hy_place▁holder▁no▁2｜>{{ end }}{{ end }}<｜hy_Assistant｜>"""
PARAMETER stop "<｜hy_place▁holder▁no▁2｜>"
PARAMETER num_ctx 8192
PARAMETER num_predict 4096
PARAMETER temperature 0.7
PARAMETER top_p 0.6
PARAMETER top_k 20
PARAMETER repeat_penalty 1.05
